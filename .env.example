# Leave these blank and fill them in locally. Nook runs without them.

# Meta Model API — Muse Spark 1.3 structured profiles, match sentences, and reranking.
# Muse Voice Transcribe for the interview recording.
# https://api.meta.ai/v1
MODEL_API_KEY=

# Meta Graph API for WhatsApp and Instagram after a stay is accepted.
# Leave these blank and messages stay in the Nook thread.
# https://developers.facebook.com/docs/graph-api
META_APP_ID=
META_APP_SECRET=
META_GRAPH_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US
INSTAGRAM_ACCOUNT_ID=
META_GRAPH_VERSION=v21.0

# Pinecone index must use dimension 32 and metric cosine.
# The vector is the 32 lifestyle axes Muse Spark returns.
PINECONE_API_KEY=
PINECONE_INDEX=nook

# MongoDB. If this is blank or unreachable, Nook uses backend/data/db.json.
MONGODB_URI=
MONGODB_DB=nook

# SMTP for the GT email code. If blank, the code is shown in the signup screen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Walking directions. Both defaults are free public servers with no key.
# Valhalla (pedestrian profile) is tried first, then OSRM, then a straight-line estimate.
# Set LIVE_ROUTING=0 to stay offline.
VALHALLA_URL=https://valhalla1.openstreetmap.de
OSRM_URL=https://router.project-osrm.org
LIVE_ROUTING=1

# Set to 1 to include the code in the API response even when SMTP works.
DEV_EXPOSE_EMAIL_CODES=

# Demo logins (Maya Chen and Andre Wallace, password WeekendNook!). Set to 0 to hide them.
DEMO_LOGIN=1

FLASK_SECRET_KEY=
PORT=5317
