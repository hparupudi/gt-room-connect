{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nook: Flask API",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/wsgi.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PORT": "5317"
      }
    }
  ],
  "compounds": [
    {
      "name": "Nook: API + UI",
      "configurations": ["Nook: Flask API"],
      "preLaunchTask": "Nook: Vite",
      "stopAll": true
    }
  ]
}
