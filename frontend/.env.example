# Vite reads this folder, not the repo root. Copy to frontend/.env to use it.
# Leave everything blank to keep the defaults.

# Where Flask answers. Blank means the same origin as the UI, which is what the
# dev proxy and a single-host deploy both want. Set it to the API's origin when
# the two are on separate hosts, e.g. VITE_API_URL=https://nook-api.onrender.com
# The API needs that UI origin in its own CORS_ORIGINS.
VITE_API_URL=

# Base map tiles. The default is OpenStreetMap's standard tiles, which need no key.
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
